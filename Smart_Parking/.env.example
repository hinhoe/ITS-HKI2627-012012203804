# Google Gemini API Key (primary) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional backup keys (comma-separated, rotated automatically if primary hits 429 quota)
# Example: GEMINI_API_KEYS=key_project_2,key_project_3
GEMINI_API_KEYS=

# Gemini vision model
GEMINI_MODEL=gemini-flash-lite-latest

# Path to YOLOv8 license plate detector model
YOLO_MODEL_PATH=AI/models/license_plate_detector.pt

# Detection confidence threshold
CONFIDENCE_THRESHOLD=0.25
